# Cabeceras servidas por Cloudflare (Pages y Workers con assets estáticos).
# Nota: si activas Rocket Loader o cualquier script inyectado por Cloudflare,
# amplía la CSP o desactiva esa opción; solo se permite el beacon de Web Analytics
# y Turnstile (challenges.cloudflare.com) para el captcha del formulario de contacto.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=3600

/favicon.ico
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=3600

/og-en.png
  Cache-Control: public, max-age=3600

/icon-*.png
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# El service worker siempre se revalida para que las actualizaciones lleguen enseguida
/sw.js
  Cache-Control: no-cache

# Código y datos que cambian con cada despliegue: el navegador siempre comprueba si hay
# una versión nueva (sin esto podría reutilizar un script.js antiguo con un HTML nuevo)
/script.js
  Cache-Control: no-cache
/content.js
  Cache-Control: no-cache
/lang.js
  Cache-Control: no-cache
/minesweeper.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/blog.css
  Cache-Control: no-cache
/blog/posts.json
  Cache-Control: no-cache
