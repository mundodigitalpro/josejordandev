{
  // Despliegue en Cloudflare Workers: `npx wrangler deploy` (o Workers Builds conectado a GitHub).
  // Sirve la web estática y el formulario de contacto (POST /api/contact), que envía el
  // correo con Email Routing. Ver README.md > Formulario de contacto.
  // Cloudflare Pages ignora este fichero: allí la web funciona igual, pero sin /api/contact
  // (el formulario ofrece entonces el enlace mailto:).
  "name": "josejordan-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Sin destination_address: el destino sale del secreto CONTACT_TO y debe ser
  // una dirección verificada en Email Routing.
  "send_email": [
    { "name": "MAILER" }
  ]
}
